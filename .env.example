# LLM provider priority when set to "auto":
# OpenRouter -> Groq -> OpenAI -> Ollama -> extractive fallback
LLM_PROVIDER=auto

# --- OpenRouter (https://openrouter.ai/keys) ---
# Limits: https://openrouter.ai/docs/api-reference/limits
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Free option: google/gemma-2-9b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_NAME=Smart Maintenance Assistant

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (optional) ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama local (optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval settings
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
